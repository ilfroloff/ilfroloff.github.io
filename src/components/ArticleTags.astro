---
interface Props {
  tags?: Array<string>;
}

const { tags } = Astro.props;
---

{tags && tags.length > 0 && (
  <span class="flex flex-wrap gap-3">
    {tags.map((item) => (
      <a
        href={`/tags/${item}`}
        class="text-[#159957] hover:text-[#159957]/[0.9]"
      >
        #{item}
      </a>
    ))}
  </span>
)}

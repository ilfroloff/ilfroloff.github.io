---
import { switchLocalePath, type Locale } from "src/utils/i18n";

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;
const currentPath = Astro.url.pathname;

const labels: Record<Locale, string> = {
  en: "EN",
  ru: "RU",
};
---

<div class="flex items-center gap-1 text-sm font-semibold">
  <a
    href={switchLocalePath(currentPath, currentLocale, "en")}
    class:list={[
      "px-1.5 py-0.5 rounded",
      currentLocale === "en"
        ? "text-indigo-800 dark:text-indigo-200 bg-indigo-100 dark:bg-indigo-900/30"
        : "text-gray-500 hover:text-gray-700 dark:hover:text-gray-300",
    ]}
  >
    {labels.en}
  </a>
  <span class="text-gray-300 dark:text-gray-600">/</span>
  <a
    href={switchLocalePath(currentPath, currentLocale, "ru")}
    class:list={[
      "px-1.5 py-0.5 rounded",
      currentLocale === "ru"
        ? "text-indigo-800 dark:text-indigo-200 bg-indigo-100 dark:bg-indigo-900/30"
        : "text-gray-500 hover:text-gray-700 dark:hover:text-gray-300",
    ]}
  >
    {labels.ru}
  </a>
</div>

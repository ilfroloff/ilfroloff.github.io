---
import { format } from "date-fns";
import ArticleTags from "./ArticleTags.astro";
import Link from "src/components/Link.astro";
import MarkdownContent from "src/components/MarkdownContent.astro";
import { localePrefix, type Locale } from "src/utils/i18n";

interface Props {
  title: string;
  source?: string;
  slug: string;
  publishedAt: Date;
  thumbnail?: string;
  tags?: Array<string>;
  icon?: string;
}

const { title, source, slug, publishedAt, tags, icon } = Astro.props;
const locale = (Astro.currentLocale ?? "en") as Locale;
const prefix = localePrefix(locale);
---

<article class="flex flex-col gap-3">
  <h1 class="text-xl">
    {icon && <span class="mr-1.5">{icon}</span>}
    <Link href={`${prefix}/${slug}`} class="font-bold">
      {title}
    </Link>
  </h1>
  {source && (
    <h5 class="text-xs italic">
      Source:
      <Link href={source} newTab>
        {source}
      </Link>
    </h5>
  )}
  <time class="text-xs text-gray-400">
    {format(new Date(publishedAt), "yyyy-MM-dd")}
  </time>
  <MarkdownContent class="prose-sm">
    <slot />
  </MarkdownContent>
  {tags && <ArticleTags tags={tags} />}
</article>

---
export interface Props {
  href: string;
  newTab?: boolean;
  class?: string;
}

const { href, newTab = false, class: className = "" } = Astro.props;
const isExternal = href.startsWith("http");
const resolvedHref = isExternal
  ? href
  : href.startsWith("/")
    ? href
    : `/${href}`;
---

<a
  class:list={["underline", className]}
  href={resolvedHref}
  target={newTab ? "_blank" : "_self"}
  rel="noreferrer"
>
  <slot />
</a>

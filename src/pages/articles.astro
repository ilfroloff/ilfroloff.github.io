---
import { getCollection } from "astro:content";
import Layout from "src/layouts/Layout.astro";
import BriefArticle from "src/components/BriefArticle.astro";
import arrayDateComparator from "src/utils/array-date-comparator";
import { getLabels } from "src/utils/i18n-labels";

const labels = getLabels("en");
const articles = await getCollection(
  "articles",
  (entry) => entry.data.lang === "en",
);
---

<Layout title={labels.articlesLabel} description={labels.articlesDescription}>
  <section class="flex flex-col gap-12">
    {articles
      .sort(arrayDateComparator((entry) => entry.data.publishedAt))
      .map((entry) => (
        <BriefArticle entry={entry} />
      ))}
  </section>
</Layout>
